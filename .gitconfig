	name = dotrunghieu2151
	email = dante.bloodhunter@gmail.com

[core]
  editor = nvim
[init]
  defaultBranch = main
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
